s": {"layers": [{"visible": true, "general_spec": {"pos_spec": {"coordinate_pos": 2, "axis_x": 0.9, "axis_y": 0.9}, "size_spec": {"width": 1, "height": 1}, "render_spec": {"opacity": 1}}, "layer_config": {"tags": {"AVATAR_LAYER": {}, "GENERAL_CFG": {"config_type": 1, "general_config": {"web_css_style": {"borderRadius": "50%"}}}}, "is_critical": true}, "resource": {"res_type": 3, "res_image": {"image_src": {"src_type": 1, "placeholder": 6, "remote": {"url": "http://i0.hdslb.com/bfs/face/fb21e54aef61b615c50ce79ac9d46a4dc65c6fa0.jpg", "bfs_style": "widget-layer-avatar"}}}}}], "is_critical_group": true}, "mid": "3441204"}}, "content": {"message": "别搞那么复杂，其根本在“贸易逆差和顺差”的盘面上，顺差方提供各种便利（合约、绿灯、站队、目的等等）来和逆差方交换，逆差方觉得合理，关税就敲定，以此维持不变。直到双方有一方觉得合同有不合理的地方，有人一直占便宜[doge]，需要改变时就会商量，商量了几次占便宜的不愿意让利，那被占便宜的就会综合考量单方面提升关税的利弊，最终觉得单方面提升关税的利大于蔽，就提升关税咯。就这么简单，经济学家应该是考量各种客观因素，建立不同的预期模型，在不同预期模型中得到一个最优解，串串叨叨的说那么多。重点提醒。。。每当你觉得“高位者”决定是不合理的，“高位者”还这么做，那不是“错与对”的范畴，那就是你把决策因素没考虑到位，就如不扶摔倒的老人，你的教育会让年轻的你觉得不不合理，但那是最优解，是有原因的，只不过年轻的你没意识到，把讹你这因素放在决策因素中。[doge]", "members": [], "emote": {"[doge]": {"id": 26, "package_id": 1, "state": 0, "type": 1, "attr": 0, "text": "[doge]", "url": "https://i0.hdslb.com/bfs/emote/3087d273a78ccaff4bb1e9972e2ba2a7583c9f11.png", "meta": {"size": 1, "suggest": [""]}, "mtime": 1668688325, "jump_title": "doge"}}, "jump_url": {}, "max_line": 6}, "replies": [{"rpid": 284115944256, "oid": 115637934360888, "type": 1, "mid": 3441204, "root": 284113965376, "parent": 284113965376, "dialog": 284115944256, "count": 0, "rcount": 0, "state": 0, "fansgrade": 0, "attr": 0, "ctime": 1764644273, "mid_str": "3441204", "oid_str": "115637934360888", "rpid_str": "284115944256", "root_str": "284113965376", "parent_str": "284113965376", "dialog_str": "284115944256", "like": 0, "action": 0, "member": {"mid": "3441204", "uname": "东尘幕祷", "handle": "", "sex": "保密", "sign": "", "avatar": "http://i0.hdslb.com/bfs/face/fb21e54aef61b615c50ce79ac9d46a4dc65c6fa0.jpg", "rank": "10000", "face_nft_new": 0, "is_senior_me